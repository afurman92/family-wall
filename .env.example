# ---- database (Vercel Postgres / Neon / any Postgres) -----------------------
# The app also accepts POSTGRES_URL and POSTGRES_PRISMA_URL (Vercel sets those).
DATABASE_URL=postgres://user:password@host:5432/db

# ---- the frame -----------------------------------------------------------------
# Long random string. The wall loads https://your-domain/frame/<FRAME_TOKEN>.
# It is READ-ONLY: it may only GET the endpoints allowlisted in middleware.ts.
FRAME_TOKEN=change-me-to-32-random-chars

# Basic auth for the whole app (the dashboard is private).
BASIC_AUTH_USER=family
BASIC_AUTH_PASS=change-me

# Per-person credentials: name:password,name:password
# scripts/members.sh reads .members.txt locally and pushes this to Vercel.
MEMBERS=alex:secret1,jordan:secret2

# Agent keys: name:key,name:key. Lets an agent in without the Basic dialog.
# API: Authorization: Bearer <key>. Browser: /agent-login?k=<key> (sets a 30-day cookie).
AGENTS=muse:change-me-to-32-random-chars

# ---- calendars (iCal feeds; leave unset and that lane stays empty) ---------------
# Google: Settings -> calendar -> "Secret address in iCal format".
# Outlook: Calendar -> Shared calendars -> Publish -> "Can view all details".
GOOGLE_ICAL_URL=        # family, shared
GOOGLE_ICAL_URL_2=      # one person's personal
GOOGLE_ICAL_URL_3=      # the other person's personal
OUTLOOK_ICAL_URL=       # one person's work
OUTLOOK_ICAL_URL_2=     # the other person's work

# ---- where the house is ---------------------------------------------------------
HOME_LAT=43.6532
HOME_LON=-79.3832
HOME_TZ=America/Toronto
NEXT_PUBLIC_HOME_TZ=America/Toronto

# Optional: override the people shown on the frame (JSON array).
# FAMILY_PEOPLE=[{"id":"alex","name":"Alex","color":"#2D5BFF","rgb":"45 91 255","ink":"#FFFFFF","home":true,"status":"Home"}]
# A third Google calendar (e.g. a partner's). Feed name: Hellen.
# GOOGLE_ICAL_URL_3=https://calendar.google.com/calendar/ical/.../basic.ics

# The household's time zone: "today", daily chores and birthdays use it.
FAMILY_TZ=America/Toronto
